  if (!(state_post->count_7454 > 0)) return 0;
  const float threshold = __builtin_bit_cast(float, 0x3c23d70au);
  /* Host when threshold <= intensity (PE jbe into spawn body). */
  return !(threshold > state_post->intensity_7458) ? 1 : 0;
